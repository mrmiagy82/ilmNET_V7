# ilmNet — voorbeeldomgeving voor de stagingdienst (permanente omgeving).
#
# Installeer als /etc/ilmnet/staging.env (mode 0600, eigenaar root of de dienstgebruiker) en houd hem
# BUITEN de repository: hij bevat het databaselogin en het legacy scripttoken.
#
#   sudo install -d -m 0750 /etc/ilmnet
#   sudo install -m 0600 ops/systemd/staging.env.example /etc/ilmnet/staging.env
#   sudo editor /etc/ilmnet/staging.env
#   sudo chown root:ilmnet /etc/ilmnet/staging.env
#
# Deze waarden komen uit de *procesomgeving* (systemd EnvironmentFile, docker compose environment:,
# PaaS-env). Een .env-bestand in de appmap mag op een stagingboot geen NODE_ENV, ENVIRONMENT,
# ADMIN_TOKEN, CORS_ORIGIN of ADMIN_ALLOW_LOCALHOST leveren — de server weigert dan te starten
# (docs/ENVIRONMENTS.md §3, regel R3). Nooit NODE_ENV=staging: die bestaat niet.
#
# Vul elke CHANGE_ME in en laat niets staan: een half ingevuld bestand laat de boot falen (dat is de
# bedoeling — liever een weigerende boot dan een omgeving die zichzelf verkeerd noemt).

# ── Identiteit ──────────────────────────────────────────────────────────────────────────────────
# De identiteit komt uit de deployment, niet uit de code. /api/health en het startlog rapporteren hem,
# en ops/deploy-check.sh --expect-environment staging controleert hem na elke deploy.
ENVIRONMENT=staging
NODE_ENV=production

# ── Database (eigen database, nooit een kopie van productiegegevens) ────────────────────────────
DATABASE_URL=postgresql://ilmnet:CHANGE_ME@localhost:5432/ilmnet_staging?schema=public

# ── Opslag (eigen, persistente uploadsmap — anders verdwijnen thumbnails bij elke redeploy) ────
UPLOADS_DIR=/var/lib/ilmnet-staging/uploads

# ── Origin en browserbeleid ─────────────────────────────────────────────────────────────────────
# Exacte origin(s) die de API mogen aanroepen, kommagescheiden. Een wildcard stopt de boot.
CORS_ORIGIN=https://staging.ilmnet.example
# Canonieke origin: doel van de http→https-redirect en de eerste HSTS-beslissing.
PUBLIC_ORIGIN=https://staging.ilmnet.example
# Wie mag x-forwarded-* zetten? Het adres/CIDR van de proxy, of true als de API alléén via de proxy
# bereikbaar is (poort niet gepubliceerd). Nooit blind vertrouwen: dit bepaalt het IP in de
# login-throttle, de HSTS-beslissing en het redirect-doel (docs/DEPLOYMENT.md §5c).
TRUST_PROXY=127.0.0.1
# Alleen aanzetten als de proxy x-forwarded-proto doorgeeft; zonder die header redirect de app in een
# lus. Laat de proxy http→https doen (docs/DEPLOYMENT.md §5b).
# FORCE_HTTPS=true
# HSTS wordt alleen op echte https-requests gestuurd. Default één jaar.
# HSTS_MAX_AGE=31536000

# ── Beveiliging van het beheer ──────────────────────────────────────────────────────────────────
# Beheerders loggen in op /admin met een gebruikersnaam + wachtwoord (sessiecookie). Dit token is
# alleen de terugvalroute voor scripts/CI. Genereer met:  openssl rand -hex 32
ADMIN_TOKEN=CHANGE_ME_openssl_rand_hex_32
# Het legacy-tokenpad staat in productie standaard UIT. Laat deze regel weg tenzij een script hem
# nodig heeft; met ADMIN_LEGACY_TOKEN=false moet er minstens één actief beheerdersaccount bestaan,
# anders weigert de server te starten (dat is de gewenste grendel).
ADMIN_LEGACY_TOKEN=true
# Sessieduur in minuten (default 720 = 12 uur, geklemd tussen 5 minuten en 30 dagen).
# ADMIN_SESSION_TTL_MINUTES=720

# ── Frontend (de API serveert dezelfde build als productie) ─────────────────────────────────────
SERVE_FRONTEND=true
# FRONTEND_DIR=/srv/ilmnet-staging/dist

# ── Verifieerbaarheid van een deploy ────────────────────────────────────────────────────────────
# Zet hier de commit die je uitrolt; ops/deploy-check.sh --expect-commit bewijst daarmee welke release
# live staat. Zonder waarde meldt /api/health commit: null in plaats van te gokken.
# GIT_COMMIT=CHANGE_ME
# Logniveau van de API: fatal|error|warn|info|debug|trace|silent (default info in productie).
# LOG_LEVEL=info

# ── Optioneel: YouTube-import via de officiële API (server-side, nooit in de frontend) ─────────
# YOUTUBE_API_KEY=
