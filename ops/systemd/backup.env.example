# ilmNet — example environment for the nightly backup timer.
#
# Install as /etc/ilmnet/backup.env (mode 0600, owned by root or the service user) and keep it
# OUTSIDE the repository: it holds the database password.
#
#   sudo install -d -m 0750 /etc/ilmnet
#   sudo install -m 0600 ops/systemd/backup.env.example /etc/ilmnet/backup.env
#   sudo editor /etc/ilmnet/backup.env      # fill in the real values
#
# DATABASE_URL must be the same value the API uses (Prisma-style parameters are tolerated: the
# scripts strip the Prisma-only ones before calling pg_dump/psql).
DATABASE_URL="postgresql://ilmnet:CHANGE_ME@localhost:5432/ilmnet?schema=public"

# Where the custom thumbnails/covers live (the API's UPLOADS_DIR).
UPLOADS_DIR="/var/lib/ilmnet/uploads"

# Where the backups are written. Point this at a different disk/volume than the database itself —
# a backup next to the live data does not survive a disk failure. Copy it off-site afterwards.
BACKUP_DIR="/var/backups/ilmnet"

# Delete backup files older than this many days (0 keeps everything).
RETENTION_DAYS="14"

# Optional: file name prefix (default: ilmnet).
# BACKUP_PREFIX="ilmnet"
