# ilmNet — example environment for the watchdog (Fase 5.6).
#
# Install as /etc/ilmnet/healthcheck.env (mode 0600): it contains DATABASE_URL, and possibly a webhook
# URL. Keep it OUTSIDE the repository.
#
#   sudo install -d -m 0750 /etc/ilmnet
#   sudo install -m 0600 ops/systemd/healthcheck.env.example /etc/ilmnet/healthcheck.env
#   sudo editor /etc/ilmnet/healthcheck.env

# What to check. The public origin is right when the watchdog runs on the host itself; use the public
# URL when it runs somewhere else. The watchdog checks the API (health/readiness), the uploads
# directory, the backup set, disk space and — optionally — the database. It does **not** look at TLS
# headers, so verify HSTS over https yourself:
#   curl -sI https://<domein>/ | grep -i strict-transport-security     (docs/DEPLOYMENT.md §5b)
BASE_URL="http://127.0.0.1:3001"

# The uploads volume (same value as the API's UPLOADS_DIR) and where the nightly backup writes.
UPLOADS_DIR="/var/lib/ilmnet/uploads"
BACKUP_DIR="/var/backups/ilmnet"
BACKUP_PREFIX="ilmnet"

# How old the newest backup set may be before this becomes a failure (hours). Leave room for one
# missed night: a 02:30 timer with 30h means "two nights without a backup" is an incident.
BACKUP_MAX_AGE_HOURS="30"

# Disk thresholds (percent used) and what to look at. Add the PostgreSQL data directory if it lives
# on its own filesystem, e.g. DISK_PATHS="/var/backups/ilmnet /var/lib/ilmnet/uploads /var/lib/postgresql".
DISK_WARN_PERCENT="85"
DISK_CRIT_PERCENT="95"
# DISK_PATHS="/var/backups/ilmnet /var/lib/ilmnet/uploads"

# Optional: verify the database itself (SELECT 1 + size). Same URL as the API; Prisma parameters
# (?schema=public, &connection_limit=…) are stripped by the script before psql sees them.
# DATABASE_URL="postgresql://ilmnet:CHANGE_ME@localhost:5432/ilmnet?schema=public"

# Where a failure goes. At least one of these is recommended: a failing run always writes its FAIL
# lines, the release and the summary to stderr (so `journalctl -u ilmnet-healthcheck` shows them), but
# without a channel below nobody is *notified*.
# A Slack/Discord/Mattermost/nfty webhook, Healthchecks.io, Uptime Kuma or your own relay — it gets a
# JSON POST: {service, host, severity, subject, timestamp, body}.
# ALERT_WEBHOOK_URL="https://hooks.example.com/services/XXXX/YYYY"
# ALERT_MAIL_TO="ops@example.com"
ALERT_SERVICE_NAME="ilmnet@web-1"

# Verbosity override for the API itself (see docs/DEPLOYMENT.md §1): info in production.
# LOG_LEVEL="warn"
