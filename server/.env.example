# ilmNet server — environment example
#
# ⚠️  DEVELOPMENT ONLY. This file is meant for local work (`npm run dev`, the test suites, seeds).
#     In production the server reads its configuration from the *process environment* (systemd
#     EnvironmentFile, `docker compose environment:`, PaaS env vars, `docker run --env-file`) and
#     it refuses to boot when a .env file here would supply NODE_ENV / ADMIN_TOKEN / CORS_ORIGIN /
#     ADMIN_ALLOW_LOCALHOST. Never place a .env file in the app directory of a production host;
#     server/.dockerignore already keeps it out of the image.
#
# ── Database ──
# local dev (matches docker-compose)
DATABASE_URL="postgresql://ilmnet:ilmnet_dev@localhost:5432/ilmnet?schema=public"
# inside docker compose use the service name instead of localhost:
# DATABASE_URL="postgresql://ilmnet:ilmnet_dev@postgres:5432/ilmnet?schema=public"

# ── Server ──
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ── CORS ──
# Exact browser origins that may call the API, comma separated.
# Production: never use "*" (the server refuses to boot with a wildcard in production).
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# ── Admin protection ──
# Admins sign in at /admin with a username + password (server-side sessions, HttpOnly cookie). This
# token is the DUAL-MODE fallback for scripts and CI: the API accepts it as an alternative to a
# session, and a production boot still refuses to start without it (Fase 3.8.1). Generate one with:
#   openssl rand -hex 32
ADMIN_TOKEN="change-me-dev-only"

# Create the first operator (never do this from the browser or with SQL):
#   npm run admin:create -- --username admin --password '<a long, unique password>'
# Also available: admin:password, admin:disable, admin:enable, admin:list.

# Session lifetime in minutes (default 720 = 12 hours; clamped to 5 minutes - 30 days). Sessions
# roll on use and are capped at 30 days; changing a password or disabling an account revokes them.
# ADMIN_SESSION_TTL_MINUTES=720

# Local development convenience: same-machine requests (vite proxy, curl, tests) skip the
# token check. Set to "false" to enforce the token even on localhost. Never active in production.
# ADMIN_ALLOW_LOCALHOST=true

# ── YouTube import (optional, server-side only) ──
# Without this key the importer reads the public YouTube watch/playlist pages (it keeps working).
# With a key it uses the official YouTube Data API v3 first: exact durations and publish dates, and
# `status.embeddable` — the one thing scraping cannot tell us, while an unembeddable video would
# create a page with a player that cannot play it. If the API rejects the key, ilmNet falls back to
# the public pages and says so in the admin preview.
#
# NEVER put this in a VITE_* variable, in the database, in the frontend or in a repository: Vite
# inlines every VITE_* value into the public bundle, and only the server talks to YouTube.
# In production set it in the process environment (systemd EnvironmentFile, docker compose
# environment:, PaaS env var), exactly like ADMIN_TOKEN.
# YOUTUBE_API_KEY=

# ── Upload storage (custom thumbnails / covers) ──
# Defaults to ./uploads next to the server. Point this at a persistent volume in production,
# otherwise uploaded images disappear on redeploy while the database keeps referencing them.
# UPLOADS_DIR=/var/lib/ilmnet/uploads

# ── Frontend hosting ──
# The API serves the built single-file frontend from ../dist when it exists.
# SERVE_FRONTEND=false        → API only (host the frontend elsewhere, set VITE_API_URL)
# FRONTEND_DIR=/app/frontend  → override the build location (see docker-compose)
# SERVE_FRONTEND=true
# FRONTEND_DIR=

# ── Seed safety ──
# `npm run seed` is DESTRUCTIVE (wipes content/scholars/subjects and inserts demo data) and
# refuses to run when NODE_ENV=production. Use `npm run seed:reference` on a fresh production
# database (adds subjects + scholars, never touches content).
# SEED_ALLOW_RESET=true  → only to deliberately wipe a production database.
