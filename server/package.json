{
  "name": "ilmnet-server",
  "version": "1.0.0",
  "description": "ilmNet backend — generic Content model (lecture/audio/video/book/document) with Fastify + Prisma + PostgreSQL",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx src/seed.ts",
    "test": "tsx test/audit.test.ts",
    "test:watch": "tsx --watch test/audit.test.ts",
    "test:uploads": "tsx test/uploads.test.ts",
    "test:all": "tsx test/audit.test.ts && tsx test/uploads.test.ts && tsx test/production.test.ts && tsx test/env-hardening.test.ts && tsx test/environment.test.ts && tsx test/ops.test.ts && tsx test/youtube.test.ts && tsx test/auth.test.ts",
    "test:production": "tsx test/production.test.ts",
    "test:imports": "tsx test/regression-imports.test.ts",
    "seed:reference": "tsx src/seed.ts --reference",
    "seed:reset": "tsx src/seed.ts",
    "deploy": "prisma migrate deploy && node dist/server.js",
    "seed:reference:built": "node dist/seed.js --reference",
    "admin:create": "tsx src/scripts/admin-user.ts create",
    "admin:password": "tsx src/scripts/admin-user.ts password",
    "admin:disable": "tsx src/scripts/admin-user.ts disable",
    "admin:enable": "tsx src/scripts/admin-user.ts enable",
    "admin:list": "tsx src/scripts/admin-user.ts list",
    "test:env": "tsx test/env-hardening.test.ts",
    "test:environment": "tsx test/environment.test.ts",
    "test:ops": "tsx test/ops.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/sensible": "^6.0.0",
    "@fastify/static": "^10.1.4",
    "@prisma/client": "^6.5.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2",
    "slugify": "^1.6.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
