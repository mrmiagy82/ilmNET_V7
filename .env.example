# ilmNet frontend build configuration (vite)
#
# VITE_API_URL  — origin of the Fastify API when the frontend is hosted separately.
#                 Leave EMPTY when the API serves the built frontend (default single-service deploy);
#                 the frontend then calls /api and /uploads on its own origin.
VITE_API_URL=

# VITE_ADMIN_TOKEN — DO NOT SET FOR PRODUCTION BUILDS.
# Vite inlines every VITE_* value into the public JavaScript bundle, so a token placed here
# would be readable by every visitor. It is only honoured by `vite dev` (npm run dev) for
# local admin work; in a deployed build the operator enters the token in Admin → Token.
VITE_ADMIN_TOKEN=
