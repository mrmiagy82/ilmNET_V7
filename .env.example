# ilmNet frontend build configuration (vite)
#
# VITE_API_URL  — origin of the Fastify API when the frontend is hosted separately.
#                 Leave EMPTY when the API serves the built frontend (default single-service deploy);
#                 the frontend then calls /api and /uploads on its own origin.
VITE_API_URL=

# VITE_ADMIN_TOKEN — OBSOLETE since Fase 4.5, and never to be set again.
# The frontend stopped reading this variable when admin sign-in moved to real accounts with a
# server-side session cookie (docs/CONTEXT.md §7f). A token in any VITE_* variable would also be
# inlined into the public bundle, where every visitor could read it. Sign in at /admin instead.
VITE_ADMIN_TOKEN=
